    <!-- Descripciones de Monterrey -->
    <string name="mty_fundidora_desc">Parque urbano incluyente, bastión de la historia industrial con áreas verdes, museos y paseo cultural.</string>
    <string name="mty_santa_lucia_desc">Canal navegable de 2.5 km considerado una de las 13 maravillas de México creadas por el hombre.</string>
    <string name="mty_macroplaza_desc">Una de las plazas públicas más grandes del mundo, corazón cultural e histórico de la ciudad.</string>
    <string name="mty_cerro_silla_desc">El ícono natural más importante y símbolo característico de la ciudad de Monterrey.</string>
    <string name="mty_barrio_antiguo_desc">Zona histórica con arquitectura del siglo XIX, galerías, cafeterías, gastronomía y vida nocturna.</string>
    <string name="mty_marco_desc">Museo de Arte Contemporáneo de Monterrey, reconocido internacionalmente por sus exhibiciones.</string>
    <string name="mty_obispado_desc">Cima del Cerro del Obispado con una vista panorámica espectacular y la Bandera Monumental.</string>
    <string name="mty_chipinque_desc">Reserva natural en la Sierra Madre Oriental ideal para senderismo, ciclismo y avistamiento de fauna.</string>
    <string name="mty_bbva_desc">Moderno estadio de fútbol, hogar de los Rayados de Monterrey y sede para la Copa Mundial de la FIFA.</string>
    <string name="mty_volcan_uanl_desc">Casa de los Tigres de la UANL, famoso por la pasión de su afición e histórica tradición deportiva.</string>
    <string name="mty_grutas_garcia_desc">Formaciones subterráneas milenarias de estalagmitas y estalactitas en el municipio de García.</string>
    <string name="mty_catedral_desc">Hermoso templo de construcción barroca novohispana con siglos de historia en el corazón de Monterrey.</string>
